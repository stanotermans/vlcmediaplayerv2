<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installers": setup + portable .exe (GitHub artifact unsigned-win-installers) -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="VLC-Redesign-Setup-*.exe" />
      <include path="VLC-Redesign-Portable-*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
