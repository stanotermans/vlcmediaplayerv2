<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.stanotermans.VelaPlayer</id>
  <name>Vela Player</name>
  <summary>Media player with Juxtopposed's design</summary>
  <developer id="io.github.stanotermans">
    <name>Stan Otermans</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>The number 1 best build with the design of Juxtopposed: a modern media player made from the redesign in the
      video "I Redesigned VLC After 25 Years". It plays with libVLC, the engine of VLC media player.</p>
    <ul>
      <li>Library with folders, playlists, recently played and where you left off</li>
      <li>Subtitles (also from OpenSubtitles) and synced lyrics</li>
      <li>Equalizer, audio and video effects, A-B repeat, chapters and bookmarks</li>
      <li>DVD menus, network streams, recording and snapshots</li>
      <li>Light, dark and system theme with accent colors, in 8 languages</li>
    </ul>
    <p>Vela Player was called VLC Redesign up to version 3.0.7. Not made by or affiliated with VideoLAN; "VLC" is a trademark of VideoLAN.</p>
  </description>
  <provides><id>io.github.stanotermans.VLCRedesign</id></provides>
  <replaces><id>io.github.stanotermans.VLCRedesign</id></replaces>
